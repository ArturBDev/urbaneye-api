// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----------------------------------------------------
// ENUMS
// ----------------------------------------------------

enum UserType {
  CITIZEN
  PUBLIC_AGENCY
  COMPANY
}

enum UserRole {
  USER
  ADMIN
  SUPER_ADMIN
}

enum OccurrenceStatus {
  PENDING
  REJECTED
  APPROVED
  CANCELLED
  CLOSED
}

enum AlertType {
  AUTOMATIC
  MANUAL
}

enum AlertLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum InteractionType {
  SUPPORT
  DISPUTE
}

enum OccurrenceType {
  FLOODING
  FIRE
  ELECTRICITY
  TRAFFIC_CONGESTION
  TRAFFIC_LIGHT_OUTAGE
  ROAD_BLOCKAGE
  ROAD_ACCIDENT
  ROAD_CONSTRUCTION
  ROAD_MAINTENANCE
  ROAD_SIGNALING
  THEFT
  OTHER
}

// ----------------------------------------------------
// MODELS
// ----------------------------------------------------

model User {
  id             String        @id @default(cuid())
  name           String
  email          String        @unique
  passwordHash   String
  phoneNumber    String        @default("")
  zipCode        String        @default("")
  country        String        @default("")
  state          String        @default("")
  city           String        @default("")
  neighborhood   String        @default("")
  street         String        @default("")
  number         String        @default("")
  complement     String?
  reference      String?
  profilePicture String?
  role           UserRole      @default(USER)
  type           UserType
  createdAt      DateTime      @default(now())
  occurrences    Occurrence[]
  interactions   Interaction[]
}

model Location {
  id           String  @id @default(cuid())
  name         String
  neighborhood String?
  city         String
  state        String
  latitude     Float
  longitude    Float
}

model Occurrence {
  id                      String           @id @default(cuid())
  title                   String
  description             String
  status                  OccurrenceStatus @default(PENDING)
  occurrenceType          OccurrenceType   @default(OTHER)
  imageUrl                String?
  latitude                Float
  responsibleOrganization String?          @default("")
  longitude               Float
  zipCode                 String           @default("")
  country                 String           @default("")
  state                   String           @default("")
  city                    String           @default("")
  neighborhood            String           @default("")
  address                 String           @default("")
  street                  String           @default("")
  number                  String           @default("")
  complement              String?
  reference               String?
  createdAt               DateTime         @default(now())
  updatedAt               DateTime         @updatedAt
  userId                  String
  user                    User             @relation(fields: [userId], references: [id])
  alerts                  Alert[]
  interactions            Interaction[]
}

model Alert {
  id           String      @id @default(cuid())
  title        String
  description  String?
  type         AlertType
  level        AlertLevel
  issuedAt     DateTime    @default(now())
  latitude     Float?
  longitude    Float?
  occurrenceId String?
  occurrence   Occurrence? @relation(fields: [occurrenceId], references: [id])
}

model Interaction {
  id           String          @id @default(cuid())
  type         InteractionType
  createdAt    DateTime        @default(now())
  userId       String
  occurrenceId String
  user         User            @relation(fields: [userId], references: [id])
  occurrence   Occurrence      @relation(fields: [occurrenceId], references: [id])

  @@unique([userId, occurrenceId])
}
